{
  "name": "school_experience",
  "private": true,
  "dependencies": {
    "@babel/core": "7",
    "@babel/preset-env": "7",
    "@googlemaps/js-api-loader": "^1.16.8",
    "@hotwired/stimulus": "^3.2.2",
    "@stimulus/polyfills": "^2.0.0",
    "@types/babel__core": "7",
    "accessible-autocomplete": "^3.0.1",
    "core-js": "^3.40.0",
    "custom-event-polyfill": "^1.0.7",
    "dfe-autocomplete": "github:DFE-Digital/dfe-autocomplete",
    "express": "5.2.1",
    "govuk-frontend": "6.5.1",
    "js-cookie": "^3.0.7",
    "json5": "2.2.3",
    "sass": "^1.105.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0"
  },
  "jest": {
    "testRegex": ".*_spec.js",
    "roots": [
      "spec/javascript"
    ],
    "testEnvironment": "jsdom",
    "moduleDirectories": [
      "node_modules",
      "app/javascript/utils",
      "app/javascript/controllers"
    ],
    "transformIgnorePatterns": [
      "node_modules/?!(stimulus)"
    ]
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "scripts": {
    "spec": "jest",
    "build": "esbuild app/javascript/*.js --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules --quiet-deps"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "24.13.0"
  }
}
